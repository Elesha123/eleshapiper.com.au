---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const magnets = await getCollection('magnets');
  return magnets.map((magnet) => ({
    params: { slug: magnet.data.slug },
    props: { magnet },
  }));
}

const { magnet } = Astro.props;
const {
  title,
  description,
  slug,
  format,
  keyword,
  subhead,
  benefits,
  formHeading,
  formButton,
  insideTitle,
  insideItems,
  testimonial,
  closingHeadline,
  closingBody,
  closingButton,
  cover,
} = magnet.data;

const ogImage = cover?.src;
---

<BaseLayout
  title={`${title} — Free download — Elesha Piper`}
  description={description}
  path={`/free/${slug}`}
  ogImage={ogImage}
>
  <nav class="nav">
    <a href="/" class="nav-brand">Elesha Piper</a>
    <a href="/">&larr; Back to site</a>
  </nav>

  <!-- HERO: offer left, opt-in right -->
  <header class="lm-hero">
    <div class="wrap lm-hero-inner">
      <div>
        <span class="lm-eyebrow">Free {format}</span>
        <h1>{title} <span class="hl">{keyword}</span></h1>
        <p class="sub">{subhead}</p>
        <ul class="lm-checks">
          {benefits.map((benefit) => (
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6 9 17l-5-5"/></svg>{benefit}</li>
          ))}
        </ul>
      </div>

      <div class="lm-form-card">
        {cover ? (
          <img src={cover.src} width={cover.width} height={cover.height} alt={`${title} cover`} class="lm-cover-img" />
        ) : (
          <div class="lm-cover">COVER<br />MOCKUP</div>
        )}
        <h2>{formHeading}</h2>
        <p class="small">Enter your details and I'll email it straight over.</p>
        <!-- TODO: wire this opt-in form to an email provider (Netlify Forms or Elesha's ESP — see templates-for-dev/README.md) before launch -->
        <form class="lm-fields">
          <input type="text" name="first_name" placeholder="First name" aria-label="First name" required />
          <input type="email" name="email" placeholder="you@company.com" aria-label="Email address" required />
          <button type="submit" class="cta cta-yellow cta-block">{formButton}</button>
        </form>
        <p class="lm-privacy">I'll also send occasional LinkedIn tips. Unsubscribe anytime.</p>
      </div>
    </div>
  </header>

  <!-- WHAT'S INSIDE -->
  <section class="inside">
    <div class="wrap">
      <div class="section-head">
        <span class="section-eyebrow">What's inside</span>
        <h2 class="section-title">{insideTitle}</h2>
      </div>
      <div class="inside-grid">
        <div class="inside-card">
          <div class="inside-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
          <h3>{insideItems[0].title}</h3>
          <p>{insideItems[0].body}</p>
        </div>
        <div class="inside-card">
          <div class="inside-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
          <h3>{insideItems[1].title}</h3>
          <p>{insideItems[1].body}</p>
        </div>
        <div class="inside-card">
          <div class="inside-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
          <h3>{insideItems[2].title}</h3>
          <p>{insideItems[2].body}</p>
        </div>
      </div>
    </div>
  </section>

  {testimonial && (
    <section class="trust">
      <div class="wrap">
        <div class="trust-inner">
          <p>&ldquo;{testimonial.quote}&rdquo;</p>
          <p class="trust-name">{testimonial.name}</p>
        </div>
      </div>
    </section>
  )}

  <!-- FINAL CTA (anchors back to the form) -->
  <section class="final">
    <div class="wrap">
      <h2>{closingHeadline}</h2>
      <p>{closingBody}</p>
      <a href="#top" class="cta cta-yellow" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;">{closingButton}</a>
    </div>
  </section>

  <footer class="site-footer">© 2026 Elesha Piper — LinkedIn content strategy, newsletters and articles.</footer>
</BaseLayout>

<style is:global>
  /* ---- hero: split offer + cover ---- */
  .lm-hero { position: relative; overflow: clip; color: #fff;
    background: radial-gradient(900px 500px at 85% -10%, rgba(155,172,216,.35), transparent 60%),
      radial-gradient(700px 500px at -10% 110%, rgba(155,172,216,.22), transparent 55%),
      linear-gradient(160deg, #2a3a94 0%, var(--navy-deep) 45%, var(--navy-ink) 100%); }
  .lm-hero::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(rgba(255,255,255,.14) 1px, transparent 1.5px); background-size: 28px 28px;
    mask-image: linear-gradient(115deg, transparent 45%, black 85%); }
  .lm-hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 5vw, 72px);
    align-items: center; padding-block: clamp(56px, 9vh, 110px); }
  .lm-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--turq); border: 1px solid rgba(155,172,216,.4);
    border-radius: 999px; padding: 8px 18px; background: rgba(155,172,216,.08); }
  .lm-hero h1 { font-size: clamp(38px, 5.5vw, 68px); line-height: .98; margin: 24px 0 0; max-width: 15ch; }
  .lm-hero h1 .hl { color: var(--green); }
  .lm-hero .sub { font-size: 18px; line-height: 1.6; max-width: 46ch; margin: 22px 0 0; color: rgba(255,255,255,.85); }
  .lm-checks { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 12px; }
  .lm-checks li { display: flex; align-items: flex-start; gap: 12px; font-size: 16px; line-height: 1.5; color: rgba(255,255,255,.92); }
  .lm-checks svg { flex: none; width: 22px; height: 22px; color: var(--green); margin-top: 1px; }

  /* opt-in card */
  .lm-form-card { background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow-3); padding: clamp(28px, 3vw, 40px);
    border: 1px solid #DAD1C8; }
  .lm-cover { width: 60%; max-width: 220px; margin: -60px auto 20px; aspect-ratio: 3/4; border-radius: var(--r-md);
    background: linear-gradient(150deg, #2f42a5, var(--navy-deep)); box-shadow: var(--shadow-2); display: grid; place-items: center;
    color: rgba(255,255,255,.6); font-family: var(--font-heading); text-transform: uppercase; letter-spacing: .1em; font-size: 12px;
    text-align: center; padding: 12px; }
  .lm-cover-img { width: 60%; max-width: 220px; margin: -60px auto 20px; aspect-ratio: 3/4; border-radius: var(--r-md);
    box-shadow: var(--shadow-2); display: block; object-fit: cover; }
  .lm-form-card h2 { font-size: clamp(22px, 2.6vw, 28px); line-height: 1.05; margin: 0; color: var(--navy-ink); text-align: center; }
  .lm-form-card p.small { font-size: 14px; line-height: 1.5; color: rgba(17,17,68,.65); margin: 10px 0 22px; text-align: center; }
  .lm-fields { display: grid; gap: 12px; }
  .lm-fields input { padding: 15px 18px; border-radius: 12px; border: 1px solid #DAD1C8; background: #fff;
    font-family: var(--font-body); font-size: 16px; color: var(--ink); }
  .lm-fields input:focus-visible { outline: 2px solid var(--navy); outline-offset: 1px; }
  .lm-privacy { font-size: 12px; color: rgba(17,17,68,.55); text-align: center; margin: 14px 0 0; }

  /* ---- what's inside ---- */
  .inside { padding: clamp(64px, 9vh, 110px) 0; }
  .inside-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 52px; }
  .inside-card { background: #fff; border: 1px solid #DAD1C8; border-radius: var(--r-lg); padding: 32px 28px;
    box-shadow: var(--shadow-1); transition: transform .25s ease, box-shadow .25s ease; }
  .inside-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-3); }
  .inside-chip { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; color: #fff;
    background: linear-gradient(150deg, #2f42a5, var(--navy-deep)); box-shadow: 0 10px 22px rgba(34,51,130,.35), inset 0 1px 0 rgba(255,255,255,.3); }
  .inside-chip svg { width: 26px; height: 26px; }
  .inside-card:nth-child(2) .inside-chip { background: linear-gradient(150deg, #17b89e, #0d7a69); }
  .inside-card:nth-child(3) .inside-chip { background: linear-gradient(150deg, #9BACD8, #7185bd); }
  .inside-card h3 { font-size: 22px; line-height: 1.1; margin: 20px 0 0; color: var(--navy-ink); }
  .inside-card p { font-size: 15px; line-height: 1.65; color: rgba(17,17,68,.75); margin: 12px 0 0; }

  /* ---- trust strip ---- */
  .trust { padding: 0 0 clamp(64px, 9vh, 110px); }
  .trust-inner { background: #fff; border: 1px solid #DAD1C8; border-radius: var(--r-lg); box-shadow: var(--shadow-1);
    padding: clamp(28px, 4vw, 44px); text-align: center; }
  .trust-inner p { font-family: var(--font-heading); font-weight: 500; text-transform: none; letter-spacing: 0;
    font-size: clamp(20px, 2.6vw, 28px); line-height: 1.25; color: var(--navy); margin: 0 auto; max-width: 60ch; }
  .trust-name { font-size: 14px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(17,17,68,.6); margin-top: 18px; }

  /* ---- final CTA ---- */
  .final { padding: clamp(56px, 8vh, 96px) 0; position: relative; overflow: clip; color: #fff;
    background: linear-gradient(160deg, #2a3a94 0%, var(--navy-deep) 50%, var(--navy-ink) 100%); }
  .final .wrap { max-width: 720px; text-align: center; }
  .final h2 { font-size: clamp(30px, 4.5vw, 52px); line-height: 1.0; margin: 0; }
  .final p { font-size: 17px; line-height: 1.6; color: rgba(255,255,255,.85); margin: 16px auto 28px; max-width: 48ch; }

  footer.site-footer { padding: 40px var(--edge); text-align: center; font-size: 14px; color: rgba(17,17,68,.6); border-top: 1px solid #DAD1C8; }

  @media (max-width: 860px) {
    .lm-hero-inner { grid-template-columns: 1fr; }
    .lm-form-card { max-width: 460px; margin: 0 auto; }
    .inside-grid { grid-template-columns: 1fr; }
  }
</style>
