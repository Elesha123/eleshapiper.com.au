---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Elesha Piper — LinkedIn content strategist';
const description =
  "LinkedIn content strategy and ghostwriting for consultants. You bring the frameworks, the wins and the client stories — I turn them into a presence that does the selling for you.";
---

<BaseLayout title={title} description={description} path="/">
<nav class="nav">
  <span class="nav-brand">Elesha Piper</span>
  <a href="#packages">Packages</a>
  <a href="/blog">Blog</a>
  <a href="#about">About</a>
  <a href="/weekly-linkedin-engine">Prompt Engine</a>
  <a href="mailto:hello@eleshapiper.com.au" class="cta cta-navy" style="color: #fff;">Get in touch</a>
</nav>

<header class="hero" data-screen-label="Hero">
  <div class="wrap hero-inner">
    <span class="hero-eyebrow">LinkedIn content strategy · Ghostwriting</span>
    <h1>You're too <span style="white-space: nowrap;">good to be this</span> <span class="hl">invisible.</span></h1>
    <p class="sub">LinkedIn content strategy and ghostwriting for consultants. You bring the frameworks, the wins and the client stories — I turn them into a presence that does the selling for you.</p>
    <div class="row">
      <a href="#packages" class="cta cta-yellow">See the packages</a>
      <a href="/weekly-linkedin-engine" class="cta cta-ghost">Try the free Prompt Engine →</a>
    </div>
  </div>
</header>

<section class="solve" id="solve" data-screen-label="What we solve">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-eyebrow">What I solve for you</span>
    </div>
    <div class="solve-grid">
      <div class="solve-card solve-1 reveal">
        <span class="icon-chip" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="16" height="10" rx="2"></rect><line x1="22" y1="11" x2="22" y2="13"></line><line x1="6" y1="10" x2="6" y2="14"></line></svg></span>
        <h3>The Mental Exhaustion</h3>
        <p>Say goodbye to the soul-crushing blank page. I protect your precious time and creative juice, completely removing the heavy lifting of content creation.</p>
      </div>
      <div class="solve-card solve-2 reveal">
        <span class="icon-chip" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path><line x1="2" y1="2" x2="22" y2="22"></line></svg></span>
        <h3>The Invisible Expert Dilemma</h3>
        <p>No more hiding your brilliance! I bridge the gap between your real-world genius and your online presence, styling a premium feed that screams “industry authority.”</p>
      </div>
      <div class="solve-card solve-3 reveal">
        <span class="icon-chip" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg></span>
        <h3>The Ghosting Habit</h3>
        <p>Say goodbye to the erratic “now you see me, now you don’t” posting cycle. I keep you consistently visible and top-of-mind with dream clients, even when your schedule is packed.</p>
      </div>
    </div>
  </div>
</section>

<section class="packages" id="packages" data-screen-label="Packages">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-eyebrow">Packages</span>
      <h2 class="section-title">Has ignoring LinkedIn cost you opportunities?</h2>
      <p class="ai-intro">Stop letting your professional reputation hide behind a blank screen. Partner with a pro to turn your brilliant insights into high-impact content that commands attention — all without adding another to-do to your already packed calendar.</p>
      <p class="pkg-ways">Two ways we can work together</p>
    </div>

    <div class="pkg-compare-wrap reveal">
      <table class="pkg-compare">
        <thead>
          <tr>
            <th class="pkg-c-blank">At a glance</th>
            <th><span class="pkg-c-pname">The Content Co-Pilot</span><span class="pkg-c-pprice">$800 / month</span></th>
            <th><span class="pkg-c-pname">Delegate &amp; Done</span><span class="pkg-c-pprice">$1,200 / month</span></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th>How it works</th>
            <td>You draft, I polish</td>
            <td>A monthly 45-min interview where I draw out your thinking and case studies, then shape it into posts</td>
          </tr>
          <tr>
            <th>Who it’s for</th>
            <td>You enjoy writing but want a pro to sharpen, design and publish it.</td>
            <td>You’d rather never touch a blank screen — hand it all over.</td>
          </tr>
          <tr>
            <th>Posts per week</th>
            <td>3</td>
            <td>4</td>
          </tr>
          <tr>
            <th>Strategy pillars &amp; editorial calendar</th>
            <td><span class="pkg-yes">Yes</span></td>
            <td><span class="pkg-yes">Yes</span></td>
          </tr>
          <tr>
            <th>Custom-designed visuals</th>
            <td><span class="pkg-yes">Yes</span></td>
            <td><span class="pkg-yes">Yes</span></td>
          </tr>
          <tr>
            <th>Scheduling &amp; publishing done for you</th>
            <td><span class="pkg-yes">Yes</span></td>
            <td><span class="pkg-yes">Yes</span></td>
          </tr>
          <tr>
            <th>Monthly 45-min interview (I extract your IP)</th>
            <td><span class="pkg-no" aria-label="Not included">—</span></td>
            <td><span class="pkg-yes">Yes</span></td>
          </tr>
          <tr>
            <th>Monthly newsletter + flagship long-form article</th>
            <td><span class="pkg-no" aria-label="Not included">—</span></td>
            <td><span class="pkg-yes">Yes</span></td>
          </tr>
          <tr>
            <th>Cross-platform SEO &amp; LLM optimisation</th>
            <td><span class="pkg-no" aria-label="Not included">—</span></td>
            <td><span class="pkg-yes">Yes</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <details class="pkg reveal" open="">
      <summary>
        <span class="pkg-sum-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></span>
        <span class="pkg-sum-name">The Content Co-Pilot</span>
        <span class="pkg-sum-price">$800 / month</span>
        <span class="pkg-sum-mark" aria-hidden="true"></span>
      </summary>
      <div class="pkg-body">
        <p class="pkg-model">You draft, I polish.</p>
        <p class="pkg-for">For the consultant who enjoys writing but wants a pro to sharpen, design and publish it — so you show up with total consistency and never miss a week.</p>
        <p class="pkg-h">The Strategic Benefit</p>
        <p>Ready to stop treating your LinkedIn like a chore and start using it like the powerful business-growth tool it is? You’ve got the brilliance, the client stories, and the industry expertise, but you’re tired of the logistical heavy lifting. This is for the consultant who wants to show up with total consistency and elite authority, without burning their brainpower on editing, design, or hitting ‘publish.’ You bring the raw, unfiltered insight; I turn it into a high-impact presence that builds trust and commands respect.</p>
        <p class="pkg-h">The Deliverables</p>
        <ul class="pkg-list">
          <li><strong>Strategic Content Pillars:</strong> we start by locking in your core pillars so every word you post is intentional, on-brand, and designed to move the needle.</li>
          <li><strong>Monthly Editorial Calendar:</strong> we work to a set calendar, taking the guesswork out of your month so you always know exactly what’s going live and why.</li>
          <li><strong>Consistent Weekly Cadence:</strong> you get 3 high-quality posts every week, ensuring you stay top-of-mind with your network.</li>
          <li><strong>Professional Editorial Refinement:</strong> I take your raw drafts and polish them until they’re sharp, authoritative, and 100% you.</li>
          <li><strong>Custom-Designed Visuals:</strong> I create high-end, scroll-stopping graphics tailored to your brand so your feed looks as professional as the work you do.</li>
          <li><strong>Total Operational Freedom:</strong> I handle the scheduling and publishing from start to finish. You get the credit for showing up consistently, and you get your week back to focus on what you do best.</li>
        </ul>
        <a href="mailto:hello@eleshapiper.com.au" class="cta cta-navy">Get in touch</a>
      </div>
    </details>

    <details class="pkg reveal">
      <summary class="pkg-sum-alt">
        <span class="pkg-sum-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2.38-1.19 4.47-3 5.74V17a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1v-2.26C6.19 13.47 5 11.38 5 9a7 7 0 0 1 7-7Z"></path><path d="M9 21h6"></path></svg></span>
        <span class="pkg-sum-name">Delegate &amp; Done</span>
        <span class="pkg-sum-price">$1,200 / month</span>
        <span class="pkg-sum-mark" aria-hidden="true"></span>
      </summary>
      <div class="pkg-body">
        <p class="pkg-model">A 45-minute monthly interview — I mine your expertise and turn it into a month of content.</p>
        <p class="pkg-for">For the consultant with deep, lived expertise who’d rather never touch a blank screen — hand the whole content engine over.</p>
        <p class="pkg-h">The Strategic Benefit</p>
        <p>If you have deep, lived expertise but find it difficult to articulate that brilliance on LinkedIn, this is your secret weapon. I act as your personal editorial partner. I spend the time getting to know your unique frameworks and industry POVs, then translate them into a high-octane content ecosystem that positions you as an authority.</p>
        <p class="pkg-h">The Deliverables</p>
        <ul class="pkg-list">
          <li><strong>The Monthly Strategy Deep-Dive:</strong> a high-leverage, 45-minute structured video interview where I extract your core IP, real-world case studies, and unique industry POVs so your voice remains authentically yours.</li>
          <li><strong>Consistent Weekly Cadence:</strong> you receive 4 high-impact posts every week, crafted to drive awareness and nurture your community, all without you staring at a blank screen.</li>
          <li><strong>LinkedIn Newsletter &amp; Long-Form Authority:</strong> I produce one deep-dive monthly newsletter to engage your most loyal followers, plus one flagship long-form article.</li>
          <li><strong>Cross-Platform SEO &amp; LLM Optimisation:</strong> your flagship article is repurposed for your website, ensuring it’s optimised to be found by Google and to feed the LLMs that your prospects are using for research.</li>
          <li><strong>Custom-Designed Visuals:</strong> you get high-end, bespoke graphics for every post and newsletter, ensuring your brand looks as elite as your consulting services.</li>
        </ul>
        <a href="mailto:hello@eleshapiper.com.au" class="cta cta-navy">Get in touch</a>
      </div>
    </details>
  </div>
</section>

<section class="ai" id="ai" data-screen-label="AI visibility">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-eyebrow">The AI &amp; LinkedIn connection</span>
      <h2 class="section-title">Your clients are asking AI. Be the answer.</h2>
      <p class="ai-intro">SEO still matters — it’s just no longer the only game in town. Your future clients are typing their biggest challenges into ChatGPT, Claude and Perplexity, looking for answers. When your thought leadership is out there doing the work, you show up in those answers — cited, quoted and remembered. <strong>That’s not a nice-to-have. That’s the top of your funnel.</strong></p>
      <p class="ai-intro">And the data backs it up — the latest AI citation studies show LinkedIn is now the ultimate destination for AI search engines.</p>
    </div>
    <div class="ai-grid">
      <div class="ai-card ai-card-1 reveal">
        <div class="ai-num">No. 1</div>
        <h3>Top Professional Domain</h3>
        <p>Industry tracking from <em>Profound</em> reveals that <strong>LinkedIn is the #1 cited domain for professional B2B queries</strong> — the questions your future clients ask — across ChatGPT, Perplexity, Gemini and Copilot.</p>
        <span class="ai-src">Source: <a href="https://www.tryprofound.com/blog/linkedin-is-the-most-cited-domain-for-professional-queries-in-ai-search" target="_blank" rel="noopener">Profound AI Search Index</a></span>
      </div>
      <div class="ai-card ai-card-2 reveal">
        <div class="ai-num">75%</div>
        <h3>Driven by Individuals</h3>
        <p>According to <em>Meltwater</em>, <strong>75% of LinkedIn citations come from individual member profiles</strong>, not generic company pages. The AI wants <em>your</em> voice, not your logo.</p>
        <span class="ai-src">Source: <a href="https://www.meltwater.com/en/resources/linkedin-gen-ai-visibility-report" target="_blank" rel="noopener">Meltwater AI Citation Study</a></span>
      </div>
      <div class="ai-card ai-card-3 reveal">
        <div class="ai-num">83%</div>
        <h3>The Power of Pure Copy</h3>
        <p><strong>83% of all AI-cited LinkedIn content consists of text posts and articles</strong> — not images or video. LLMs eat structured words. That is exactly what I write for you.</p>
        <span class="ai-src">Source: <a href="https://www.meltwater.com/en/resources/linkedin-gen-ai-visibility-report" target="_blank" rel="noopener">Meltwater AI Citation Study</a></span>
      </div>
    </div>
    <p class="ai-asof">Figures reflect the latest published AI-citation studies, current as of July 2026.</p>

    <div class="follow-panel reveal">
      <div class="follow-copy">
        <span class="section-eyebrow">Free weekly prompts</span>
        <h3>Best LinkedIn Prompts for Consultants</h3>
        <p>Every week I share prompts designed specifically for consultants — real inspo to help you show up on LinkedIn instead of staring at a blank screen. It’s free, it’s practical, and it’s waiting for you.</p>
      </div>
      <a href="https://www.linkedin.com/company/ai-prompts-for-consultants/" target="_blank" rel="noopener" class="cta cta-navy">Follow on LinkedIn</a>
    </div>
  </div>
</section>

<section class="engine" data-screen-label="Weekly LinkedIn Engine">
  <div class="wrap">
    <div class="engine-band reveal">
      <div class="engine-in">
        <div>
          <span class="engine-eb">Free interactive tool · No email needed</span>
          <h2>Try my <span class="hl">Weekly LinkedIn Engine</span></h2>
          <p>Your Friday ritual: share this week's wins and lessons, add your own writing style, and get back ready-to-post LinkedIn drafts in your voice. Genuinely free — no sign-up, no catch, nothing saved.</p>
          <ul class="engine-ticks">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Posts in your voice</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Ready in minutes</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Nothing stored</li>
          </ul>
        </div>
        <div class="engine-act">
          <a href="/weekly-linkedin-engine" class="cta cta-yellow">Start writing free →</a>
          <span class="fineprint">No email. No credit card. Just open it.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="proof" id="proof" data-screen-label="Social proof">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="section-eyebrow">What clients say</span>
    </div>
    <div class="proof-grid">
      <div class="proof-card reveal">
        <div class="proof-top">
          <div>
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p class="proof-name">John Barton and Richard Palmer · Co-founders, Qurate Advisory</p>
          </div>
        </div>
        <blockquote>“Like a lot of founders, we knew LinkedIn mattered and never quite got to it. The ideas were there. Getting them out of our heads and into something worth publishing was the part that never happened.<br><br>Elesha changed that. She took the way we actually think about business exits and transitions and turned it into content that sounds like us, not like everyone else. She kept us consistent when we would have gone quiet, and she did it without needing us to spend hours we did not have.<br><br>What sets her apart is that she gets the thinking first. The posts, the articles, the whole presence, they all trace back to ideas we recognise as ours. That is rare, and it is the reason our presence on LinkedIn finally reflects the work we actually do.<br><br>If you are a consultant with good ideas and no time to build a presence around them, talk to Elesha.”</blockquote>
      </div>
    </div>
  </div>
</section>

<section class="about" id="about" data-screen-label="About">
  <div class="wrap about-grid">
    <div class="reveal">
      <span class="section-eyebrow">Hello!</span>
      <h2>I'm Elesha</h2>
      <div class="note">
        <p><b>I work with brilliant consultants who are quietly excellent and loudly invisible.</b></p>
        <p>Here’s what I’ve learned after a decade in content marketing: the people with the most valuable expertise are almost always the worst at explaining it. Not because they can’t write but because they’re too close to it. What’s obvious to you is a revelation to your client, and you’ve stopped being able to tell the difference.</p>
        <p>My job is to find that difference and put it on the page. Just LinkedIn, just consultants. Your expertise, in your voice, sounding like the best version of you.</p>
      </div>
      <button type="button" class="cta cta-yellow" onclick="document.getElementById('bio-modal').showModal()">A little more about me</button>
    </div>
    <div class="cred-list reveal">
      <div class="cred-item cred-1">
        <span class="cred-num">360°</span>
        <div>
          <h3>The full content arsenal</h3>
          <p>Email campaigns that convert, social media that stops the scroll, podcast appearances secured, and a working command of SEO and LLM visibility — a decade of making words do the heavy lifting.</p>
        </div>
      </div>
      <div class="cred-item cred-2">
        <span class="cred-num">A–Z</span>
        <div>
          <h3>Clients across the map</h3>
          <p>Business advisors and consultants, columnists for major Australian publications (writing as their voice behind the scenes), financial institutions and, life coaches at the top of the global game — and everything from skincare to plumbing in between.</p>
        </div>
      </div>
      <div class="cred-item cred-3">
        <span class="cred-num">AI</span>
        <div>
          <h3>All in, from day one</h3>
          <p>An early adopter of the very first ChatGPT models — I leverage AI, mainly Claude, to optimise workflows and deliver sharper thinking, faster.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="close" id="contact" data-screen-label="Contact">
  <div class="wrap">
    <div class="close-panel reveal">
      <span class="section-eyebrow">Get in touch</span>
      <h2>Ready to show up consistently?</h2>
      <p class="sub">Tell me about your work and which package fits. If you’re not sure, we’ll figure it out together on a short call.</p>
      <div class="row">
        <a href="mailto:hello@eleshapiper.com.au" class="cta cta-navy">Email Elesha</a>
      </div>
      <p class="contact-email"><a href="mailto:hello@eleshapiper.com.au">hello@eleshapiper.com.au</a></p>
    </div>
  </div>
</section>

<footer>© 2026 Elesha Piper — LinkedIn content strategy, newsletters and articles.</footer>

<dialog id="bio-modal" class="bio-modal" aria-labelledby="bio-title">
  <div class="bio-inner">
    <div class="bio-head">
      <div>
        <span class="section-eyebrow">About</span>
        <h2 id="bio-title" class="bio-title">A little more about me</h2>
      </div>
      <button type="button" class="bio-close" onclick="document.getElementById('bio-modal').close()" aria-label="Close">✕</button>
    </div>
    <div class="bio-body">
      <p>I’ve spent a decade in content marketing, across just about every niche you can think of — finance, elite personal-development coaches, consultants, ghost-writing for columnists at some of Australia’s biggest publications, and supporting authors with their promotion. The through-line is always the same: helping smart people stay consistent and sound like themselves, whether that’s a newsletter, an article or their social media. By day I lead marketing at a high-growth Australian financial firm, so I’m not doing this from the sidelines — I live and breathe it, and I consult around it.</p>
      <p>And I’m all in on AI. I was an early adopter of the very first ChatGPT models and saw straight away what they meant for a solo consultant: real leverage. I’ve built my practice around getting the most out of Claude, ChatGPT, Perplexity and the rest. AI brings the productivity. I bring a genuine passion for getting to know a consultant’s work — and I actually care about the outcome. Together, that’s a winning combination for quality and speed.</p>
      <p><strong>Who I work with:</strong> consultants, advisors and specialists who are genuinely good and genuinely underexposed. People who’d rather be doing the work than marketing it — but who know that if nobody sees it, nobody hires them.</p>
      <p><strong>Let’s make you impossible to overlook.</strong></p>
    </div>
  </div>
</dialog>
</BaseLayout>

<style is:global>
/* hero */
.hero { position: relative; overflow: clip; color: #fff;
  background:
    radial-gradient(900px 500px at 85% -10%, rgba(155, 172, 216, .35), transparent 60%),
    radial-gradient(700px 500px at -10% 110%, rgba(155, 172, 216, .22), transparent 55%),
    linear-gradient(160deg, #2a3a94 0%, var(--navy-deep) 45%, var(--navy-ink) 100%); }
.hero::after { content: ""; position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(rgba(255,255,255,.14) 1px, transparent 1.5px);
  background-size: 28px 28px; mask-image: linear-gradient(115deg, transparent 45%, black 85%); }
.hero-inner { position: relative; z-index: 1; padding-block: clamp(80px, 12vh, 150px) clamp(72px, 10vh, 130px); }
.hero-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 600;
  letter-spacing: 0.14em; text-transform: uppercase; color: var(--turq);
  border: 1px solid rgba(155, 172, 216, .4); border-radius: 999px; padding: 8px 18px;
  background: rgba(155, 172, 216, .08); backdrop-filter: blur(4px); }
.hero h1 { font-size: clamp(52px, 8vw, 108px); line-height: .95; margin: 28px 0 0; letter-spacing: 0.01em; max-width: 12ch; }
.hero h1 .hl { color: var(--yellow); position: relative; white-space: nowrap; }
.hero h1 .hl::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0.02em; height: 0.1em;
  background: linear-gradient(90deg, var(--yellow), var(--turq)); border-radius: 999px; opacity: .9; }
.hero .sub { font-size: 18px; line-height: 1.6; max-width: 56ch; margin: 28px 0 0; color: rgba(255,255,255,.85); }
.hero .row { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 36px; }

/* solve */
.solve { position: relative; padding: clamp(72px, 9vh, 110px) 0; }
.section-head { text-align: center; max-width: 640px; margin: 0 auto; }
.section-eyebrow { display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--navy); background: rgba(34,51,130,.08);
  border-radius: 999px; padding: 7px 16px; }
.section-title { font-size: clamp(32px, 4.2vw, 48px); line-height: 1.02; margin: 18px 0 0; color: var(--navy-ink); }
.solve-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 52px; }
.solve-card { position: relative; background: #fff; border-radius: var(--r-lg); padding: 34px 30px;
  box-shadow: var(--shadow-1); border: 1px solid #DAD1C8;
  transition: transform .25s ease, box-shadow .25s ease; }
.solve-card:hover { transform: translateY(-8px) rotate(-.5deg); box-shadow: var(--shadow-3); }
.solve-card::before { content: ""; position: absolute; inset: 0 auto auto 30px; top: 0; width: 56px; height: 5px;
  border-radius: 0 0 6px 6px; transition: width .3s ease; }
.solve-card:hover::before { width: 96px; }
.solve-1::before { background: linear-gradient(90deg, var(--navy), #3d55c4); }
.solve-2::before { background: linear-gradient(90deg, #129C86, #17b89e); }
.solve-3::before { background: linear-gradient(90deg, #9BACD8, #b3c1e3); }
.solve-1 .icon-chip { background: linear-gradient(150deg, #2f42a5, var(--navy-deep)); }
.solve-2 .icon-chip { background: linear-gradient(150deg, #17b89e, #0d7a69); }
.solve-3 .icon-chip { background: linear-gradient(150deg, #9BACD8, #7185bd); }
.solve-1:hover { background: linear-gradient(180deg, #fff, rgba(34, 51, 130, .05)); }
.solve-2:hover { background: linear-gradient(180deg, #fff, rgba(18, 156, 134, .07)); }
.solve-3:hover { background: linear-gradient(180deg, #fff, rgba(155, 172, 216, .12)); }
.solve-card .icon-chip { transition: transform .3s ease; }
.solve-card:hover .icon-chip { transform: scale(1.08) rotate(-4deg); }
.icon-chip { width: 60px; height: 60px; border-radius: 18px; display: grid; place-items: center; color: #fff;
  background: linear-gradient(150deg, #2f42a5, var(--navy-deep));
  box-shadow: 0 10px 22px rgba(34, 51, 130, .35), inset 0 1px 0 rgba(255,255,255,.3); }
.icon-chip svg { width: 28px; height: 28px; animation: icon-float 3s ease-in-out infinite; }
.solve-card:nth-child(2) .icon-chip svg { animation-delay: .4s; }
.solve-card:nth-child(3) .icon-chip svg { animation-delay: .8s; }
@keyframes icon-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
@media (prefers-reduced-motion: reduce) { .icon-chip svg { animation: none; } }
.solve-card h3 { font-size: 24px; line-height: 1.1; margin: 22px 0 0; color: var(--navy-ink); }
.solve-card p { font-size: 15.5px; line-height: 1.65; color: rgba(17, 17, 68, .75); margin: 12px 0 0; }

/* packages */
.packages { padding: clamp(64px, 8vh, 100px) 0; position: relative;
  background:
    radial-gradient(700px 400px at 100% 0%, rgba(155, 172, 216, .18), transparent 60%),
    linear-gradient(180deg, rgba(34,51,130,.04), transparent 40%); }
.pkg { border-radius: var(--r-lg); margin-top: 26px; background: #fff; overflow: clip;
  box-shadow: var(--shadow-1); border: 1px solid #DAD1C8;
  transition: box-shadow .22s ease; }
.pkg[open] { box-shadow: var(--shadow-2); }
.pkg summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 20px;
  padding: 26px 32px; color: #fff;
  background: linear-gradient(120deg, #2f42a5, var(--navy) 55%, var(--navy-deep));
  transition: filter .18s ease; }
.pkg summary:hover { filter: brightness(1.08); }
.pkg summary:focus-visible { outline: 2px solid var(--turq); outline-offset: -4px; }
.pkg summary::-webkit-details-marker { display: none; }
.pkg summary.pkg-sum-alt { background: linear-gradient(120deg, #3d55c4, #2f42a5 55%, var(--navy-deep)); }
.pkg-sum-icon { flex: none; width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center;
  color: var(--navy-ink); background: linear-gradient(180deg, color-mix(in srgb, var(--yellow) 75%, white), var(--yellow));
  box-shadow: 0 6px 14px rgba(17,17,68,.28), inset 0 1px 0 rgba(255,255,255,.5); }
.pkg-sum-icon svg { width: 24px; height: 24px; }
.pkg-sum-alt .pkg-sum-icon { color: #fff; background: linear-gradient(180deg, #17b89e, #0d7a69); }
.pkg-ways { font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;
  font-size: 15px; color: var(--navy); margin: 30px 0 0; }
.pkg-sum-name { flex: 1; font-family: var(--font-heading); font-weight: var(--font-heading-weight);
  text-transform: uppercase; letter-spacing: 0.03em; font-size: clamp(24px, 3vw, 32px); line-height: 1.05; }
.pkg-sum-price { font-family: var(--font-heading); font-weight: 700; font-size: 20px; color: var(--navy-ink);
  background: linear-gradient(180deg, color-mix(in srgb, var(--yellow) 75%, white), var(--yellow)); padding: 8px 18px; border-radius: 999px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.6), 0 4px 10px rgba(17,17,68,.25); white-space: nowrap; }
.pkg-sum-mark { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; flex: none;
  border: 1.5px solid rgba(255,255,255,.5); font-size: 22px; font-weight: 300; color: #fff;
  transition: transform .25s ease, background .18s ease; }
.pkg-sum-mark::before { content: "+"; }
.pkg[open] .pkg-sum-mark { transform: rotate(45deg); background: rgba(255,255,255,.15); }
.pkg-body { padding: 34px clamp(24px, 4vw, 44px) 40px; }
.pkg-body p { font-size: 15.5px; line-height: 1.65; color: rgba(17, 17, 68, .78); margin: 16px 0 0; max-width: 74ch; }
.pkg-for { font-style: italic; font-size: 17px !important; color: var(--navy) !important; margin-top: 0 !important; }
.pkg-h { font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700;
  color: var(--navy); margin: 26px 0 0; }
.pkg-list { margin: 12px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
.pkg-list li { font-size: 15.5px; line-height: 1.6; color: rgba(17, 17, 68, .78);
  padding-left: 30px; position: relative; }
.pkg-list li::before { content: "✓"; position: absolute; left: 0; top: 1px; width: 20px; height: 20px;
  border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700;
  color: var(--navy-ink); background: linear-gradient(180deg, color-mix(in srgb, var(--yellow) 75%, white), var(--yellow));
  box-shadow: 0 2px 5px rgba(17,17,68,.2); }
.pkg-outcome { border-top: 1px solid rgba(34, 51, 130, .12); margin-top: 28px !important; padding-top: 24px; }
.pkg-body .cta { margin-top: 28px; }
.pkg-body .pkg-model { font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
  letter-spacing: .04em; font-size: 18px; color: var(--navy-ink) !important; margin: 0 0 4px !important; }

/* comparison table */
.pkg-compare-wrap { margin-top: 24px; overflow-x: auto; border-radius: var(--r-lg);
  box-shadow: var(--shadow-2); border: 1px solid #DAD1C8; background: #fff; }
.pkg-compare { width: 100%; min-width: 560px; border-collapse: collapse; }
.pkg-compare th, .pkg-compare td { text-align: left; padding: 16px 22px; vertical-align: top;
  border-bottom: 1px solid rgba(34,51,130,.1); font-size: 15px; line-height: 1.5; }
.pkg-compare thead th { color: #fff; vertical-align: bottom;
  background: linear-gradient(120deg, #2f42a5, var(--navy) 55%, var(--navy-deep)); border-bottom: none; }
.pkg-compare thead th:nth-child(3) { background: linear-gradient(120deg, #3d55c4, #2f42a5 55%, var(--navy-deep)); }
.pkg-compare thead th.pkg-c-blank { background: var(--navy-ink); }
.pkg-c-pname { display: block; font-family: var(--font-heading); font-weight: var(--font-heading-weight);
  text-transform: uppercase; letter-spacing: .03em; font-size: 21px; line-height: 1.05; }
.pkg-c-pprice { display: inline-block; margin-top: 8px; font-family: var(--font-heading); font-weight: 700;
  font-size: 15px; color: var(--navy-ink);
  background: linear-gradient(180deg, color-mix(in srgb, var(--yellow) 75%, white), var(--yellow));
  padding: 4px 12px; border-radius: 999px; }
.pkg-compare tbody th { font-weight: 600; color: var(--navy); width: 34%; }
.pkg-compare td { color: rgba(17,17,68,.8); }
.pkg-compare tbody tr:last-child th, .pkg-compare tbody tr:last-child td { border-bottom: none; }
.pkg-compare tbody tr:nth-child(even) { background: rgba(34,51,130,.03); }
.pkg-yes { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: #0d7a69; }
.pkg-yes::before { content: "\2713"; display: grid; place-items: center; width: 20px; height: 20px; flex: none;
  border-radius: 50%; font-size: 11px; color: #fff; background: linear-gradient(180deg, #17b89e, #0d7a69); }
.pkg-no { color: rgba(17,17,68,.35); font-size: 18px; }

/* AI visibility band */
.ai { position: relative; overflow: clip; padding: clamp(72px, 9vh, 110px) 0;
  background:
    radial-gradient(800px 500px at 90% -10%, rgba(18, 156, 134, .1), transparent 55%),
    radial-gradient(700px 500px at 0% 110%, rgba(155, 172, 216, .18), transparent 55%),
    linear-gradient(180deg, #fff 0%, var(--baby) 100%); }
.ai::after { content: ""; position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(rgba(34, 51, 130, .14) 1px, transparent 1.5px);
  background-size: 28px 28px; mask-image: linear-gradient(245deg, transparent 55%, black 95%); }
.ai .wrap { position: relative; z-index: 1; }
.ai .section-eyebrow { color: #0a5f52; background: rgba(18, 156, 134, .12); }
.ai-intro { font-size: 17px; line-height: 1.65; color: rgba(17, 17, 68, .78); max-width: 62ch; margin: 22px auto 0; }
.ai-intro strong { color: var(--navy-ink); }
.ai-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 52px; }
.ai-card { position: relative; border-radius: var(--r-lg); padding: 34px 30px;
  box-shadow: var(--shadow-2);
  transition: transform .22s ease, box-shadow .22s ease; }
.ai-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-3); }
.ai-num { font-family: var(--font-heading); font-weight: 700; font-size: clamp(56px, 6vw, 84px); line-height: .95; }
.ai-card h3 { font-size: 22px; line-height: 1.1; margin: 16px 0 0; }
.ai-card p { font-size: 15px; line-height: 1.65; margin: 14px 0 0; }
.ai-src { display: block; margin-top: 20px; padding-top: 16px; font-size: 13px; letter-spacing: 0.04em; }
/* card 1 — deep royal */
.ai-card-1 { color: #fff; background: linear-gradient(150deg, #2f42a5, var(--navy-deep) 60%, var(--navy-ink));
  border: 1px solid rgba(255,255,255,.12); }
.ai-card-1 .ai-num { color: var(--yellow); }
.ai-card-1 h3, .ai-card-1 p strong { color: #fff; }
.ai-card-1 p { color: rgba(255,255,255,.82); }
.ai-card-1 .ai-src { border-top: 1px solid rgba(255,255,255,.18); }
.ai-card-1 .ai-src a { color: var(--turq); }
.ai-card-1 .ai-src a:hover { color: #fff; }
/* card 2 — habañero */
.ai-card-2 { color: #fff; background: linear-gradient(150deg, #17b89e, #129C86 55%, #0d7a69);
  border: 1px solid rgba(255,255,255,.25); }
.ai-card-2 .ai-num { color: #fff; text-shadow: 0 2px 12px rgba(17,17,68,.2); }
.ai-card-2 h3, .ai-card-2 p strong { color: #fff; }
.ai-card-2 p { color: rgba(255, 255, 255, .85); }
.ai-card-2 .ai-src { border-top: 1px solid rgba(255,255,255,.25); }
.ai-card-2 .ai-src a { color: #fff; }
/* card 3 — aster blue */
.ai-card-3 { color: var(--navy-ink); background: linear-gradient(150deg, #b3c1e3, #9BACD8 60%, #8496cc);
  border: 1px solid rgba(255,255,255,.35); }
.ai-card-3 .ai-num { color: var(--navy-deep); }
.ai-card-3 h3, .ai-card-3 p strong { color: var(--navy-ink); }
.ai-card-3 p { color: rgba(17, 17, 68, .82); }
.ai-card-3 .ai-src { border-top: 1px solid rgba(17,17,68,.2); }
.ai-card-3 .ai-src a { color: var(--navy-deep); }
.ai-asof { margin: 22px 0 0; text-align: center; font-size: 13px; letter-spacing: .04em;
  color: rgba(17,17,68,.5); font-style: italic; }
@media (max-width: 900px) { .ai-grid { grid-template-columns: 1fr; } .follow-panel { flex-direction: column; text-align: center; } }
/* follow panel */
.follow-panel { display: flex; align-items: center; gap: clamp(24px, 4vw, 56px); margin-top: 52px;
  background: #fff; border: 1px solid #DAD1C8; border-radius: var(--r-lg);
  padding: clamp(28px, 4vw, 44px) clamp(24px, 4vw, 48px);
  box-shadow: var(--shadow-1); position: relative; overflow: clip; }
.follow-panel::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 6px;
  background: linear-gradient(180deg, #129C86, var(--navy)); }
.follow-copy { flex: 1; }
.follow-copy h3 { font-size: clamp(24px, 3vw, 32px); line-height: 1.05; margin: 14px 0 0; color: var(--navy-ink); }
.follow-copy p { font-size: 15.5px; line-height: 1.65; color: rgba(17, 17, 68, .78); margin: 12px 0 0; max-width: 58ch; }
.follow-panel .cta { flex: none; }

/* engine CTA band */
.engine { padding: clamp(56px, 8vh, 100px) 0; }
.engine-band { position: relative; overflow: hidden; border-radius: var(--r-lg); color: #fff;
  padding: clamp(40px, 6vw, 72px) clamp(28px, 5vw, 72px);
  background: radial-gradient(760px 460px at 88% -12%, rgba(155,172,216,.32), transparent 60%),
    radial-gradient(600px 420px at -8% 118%, rgba(18,156,134,.28), transparent 58%),
    linear-gradient(160deg, #2a3a94 0%, var(--navy-deep) 48%, var(--navy-ink) 100%);
  box-shadow: var(--shadow-3); }
.engine-band::after { content: ""; position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(rgba(255,255,255,.13) 1px, transparent 1.5px); background-size: 30px 30px;
  mask-image: linear-gradient(115deg, transparent 42%, black 88%); }
.engine-in { position: relative; z-index: 1; display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
.engine-eb { display: inline-flex; align-items: center; gap: 9px; font-size: 12.5px; font-weight: 600;
  letter-spacing: .16em; text-transform: uppercase; color: var(--turq); font-family: var(--font-heading);
  border: 1px solid rgba(155,172,216,.4); border-radius: 999px; padding: 7px 16px; background: rgba(155,172,216,.08); }
.engine-in h2 { font-size: clamp(32px, 4.6vw, 56px); line-height: .98; margin: 20px 0 0; color: #fff; }
.engine-in h2 .hl { color: var(--yellow); }
.engine-in > div > p { font-size: 17.5px; line-height: 1.6; color: rgba(255,255,255,.85); margin: 18px 0 0; max-width: 52ch; }
.engine-ticks { display: flex; flex-wrap: wrap; gap: 10px 22px; margin: 24px 0 0; padding: 0; list-style: none; }
.engine-ticks li { display: flex; align-items: center; gap: 9px; font-size: 14.5px; font-weight: 600; color: rgba(255,255,255,.92); }
.engine-ticks svg { width: 20px; height: 20px; color: var(--yellow); flex: none; }
.engine-act { display: flex; flex-direction: column; align-items: stretch; gap: 12px; }
.engine-act .cta { width: 100%; font-size: 19px; padding: 18px 28px; }
.engine-act .fineprint { text-align: center; font-size: 13px; letter-spacing: .03em; color: rgba(255,255,255,.6); }
@media (max-width: 820px) { .engine-in { grid-template-columns: 1fr; } }

/* proof */
.proof { padding: clamp(56px, 7vh, 90px) 0 clamp(64px, 8vh, 100px); position: relative; overflow: clip; color: #fff;
  background:
    radial-gradient(700px 450px at 90% -10%, rgba(155, 172, 216, .25), transparent 55%),
    linear-gradient(160deg, #2a3a94 0%, var(--navy-deep) 50%, var(--navy-ink) 100%); }
.proof .section-eyebrow { color: var(--yellow); background: rgba(18, 156, 134, .16); }
.proof-grid { display: grid; grid-template-columns: 1fr; max-width: 680px; margin: 52px auto 0; }
.proof-card { position: relative; background: #fff; border-radius: var(--r-lg); padding: 34px 30px;
  box-shadow: var(--shadow-1); border: 1px solid #DAD1C8;
  transition: transform .22s ease, box-shadow .22s ease; }
.proof-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
.proof-card::before { content: "“"; position: absolute; top: 6px; right: 26px;
  font-family: var(--font-heading); font-size: 110px; line-height: 1; color: rgba(155, 172, 216, .35); }
.proof-top { display: flex; align-items: center; gap: 18px; }
.proof-top image-slot { width: 64px; height: 64px; flex: none; border-radius: 50%;
  box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--turq); }
.stars { color: #12C4A5; font-size: 17px; letter-spacing: 3px; line-height: 1; }
.proof-name { font-family: var(--font-heading); font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.04em; font-size: 17px; margin: 8px 0 0; color: var(--navy-ink); }
.proof-card blockquote { margin: 22px 0 0; font-size: 15.5px; line-height: 1.65; color: rgba(17, 17, 68, .78); }

/* about */
.about { position: relative; overflow: clip; padding: clamp(72px, 9vh, 110px) 0;
  background:
    radial-gradient(700px 450px at 110% 10%, rgba(18, 156, 134, .1), transparent 55%),
    radial-gradient(600px 400px at -10% 100%, rgba(155, 172, 216, .22), transparent 55%),
    linear-gradient(180deg, var(--baby) 0%, #EAE4DB 100%); }
.about-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 24px clamp(32px, 6vw, 88px); align-items: center; }
.about .section-eyebrow { color: #0a5f52; background: rgba(18, 156, 134, .12); }
.about h2 { font-size: clamp(34px, 4.4vw, 52px); line-height: 1.0; margin: 18px 0 0; color: var(--navy-ink); }
.about .note p { font-size: 16px; line-height: 1.65; color: rgba(17, 17, 68, .8); margin: 18px 0 0; }
.about .note b { color: var(--navy-ink); }
.about .cta { margin-top: 30px; }
.about-figure { margin: 0; position: relative; }
.about-figure::before { content: ""; position: absolute; inset: 18px -18px -18px 18px; border-radius: var(--r-lg);
  background: linear-gradient(140deg, rgba(104,205,231,.5), rgba(247,249,167,.35)); filter: blur(2px); }
.about-figure image-slot { position: relative; width: 100%; aspect-ratio: 4 / 5; border-radius: var(--r-lg);
  box-shadow: var(--shadow-3); }

/* cred list */
.cred-list { display: flex; flex-direction: column; gap: 18px; }
.cred-item { display: flex; align-items: flex-start; gap: 20px; border-radius: var(--r-md);
  padding: 22px 24px; box-shadow: var(--shadow-2);
  transition: transform .22s ease, box-shadow .22s ease; }
.cred-item:hover { transform: translateX(6px); box-shadow: var(--shadow-3); }
.cred-num { flex: none; min-width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center;
  font-family: var(--font-heading); font-weight: 700; font-size: 24px; padding: 0 10px;
  box-shadow: 0 8px 18px rgba(17,17,68,.25), inset 0 1px 0 rgba(255,255,255,.4); }
.cred-item h3 { font-size: 19px; line-height: 1.15; margin: 0; }
.cred-item p { font-size: 14.5px; line-height: 1.6; margin: 8px 0 0; }
.cred-1 { color: #fff; background: linear-gradient(150deg, #2f42a5, var(--navy-deep) 60%, var(--navy-ink)); }
.cred-1 h3 { color: #fff; } .cred-1 p { color: rgba(255,255,255,.82); }
.cred-1 .cred-num { color: var(--navy-ink); background: linear-gradient(180deg, color-mix(in srgb, var(--yellow) 75%, white), var(--yellow)); }
.cred-2 { color: #fff; background: linear-gradient(150deg, #17b89e, #129C86 55%, #0d7a69); }
.cred-2 h3 { color: #fff; } .cred-2 p { color: rgba(255,255,255,.85); }
.cred-2 .cred-num { color: #0a5f52; background: rgba(255,255,255,.9); }
.cred-3 { color: var(--navy-ink); background: linear-gradient(150deg, #b3c1e3, #9BACD8 60%, #8496cc); }
.cred-3 h3 { color: var(--navy-ink); } .cred-3 p { color: rgba(17,17,68,.82); }
.cred-3 .cred-num { color: var(--navy-deep); background: rgba(255,255,255,.85); }

/* contact */
.close { padding: clamp(72px, 9vh, 110px) 0 clamp(56px, 7vh, 80px); text-align: center; }
.close-panel { position: relative; background: #fff; border-radius: 28px; padding: clamp(44px, 6vw, 72px) clamp(24px, 5vw, 64px);
  box-shadow: var(--shadow-2); border: 1px solid #DAD1C8; overflow: clip; }
.close-panel::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 6px;
  background: linear-gradient(90deg, var(--navy), var(--turq), var(--yellow)); }
.close h2 { font-size: clamp(30px, 3.8vw, 44px); line-height: 1.02; margin: 18px 0 0; color: var(--navy-ink); }
.close .sub { font-size: 16.5px; line-height: 1.65; color: rgba(17, 17, 68, .75); max-width: 52ch; margin: 16px auto 0; }
.close .row { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 32px; }
.contact-email { margin: 18px 0 0; font-size: 15px; font-weight: 600; }
.contact-email a { color: var(--navy); text-decoration: none; border-bottom: 1px solid rgba(34,51,130,.35); padding-bottom: 1px; transition: color .2s, border-color .2s; }
.contact-email a:hover { color: var(--turq); border-color: var(--turq); }
footer { padding: 0 0 44px; font-size: 13.5px; text-align: center; color: rgba(17, 17, 68, .55); }

/* bio modal */
.bio-modal { border: 0; border-radius: var(--r-lg); padding: 0;
  width: min(760px, calc(100vw - 40px)); max-height: 85vh;
  background: #fff; color: var(--ink); box-shadow: var(--shadow-3); }
.bio-modal::backdrop { background: rgba(17, 17, 68, .55); backdrop-filter: blur(6px); }
.bio-inner { padding: 40px clamp(24px, 5vw, 52px) 48px; }
.bio-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
.bio-title { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.05; margin: 14px 0 0; color: var(--navy-ink); }
.bio-close { flex: none; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid rgba(34,51,130,.3);
  background: #fff; color: var(--navy); font-size: 20px; cursor: pointer; display: grid; place-items: center;
  transition: background .15s, transform .15s; }
.bio-close:hover { background: rgba(34,51,130,.08); transform: rotate(90deg); }
.bio-close:focus-visible { outline: 2px solid var(--navy); outline-offset: 2px; }
.bio-body p { font-size: 15.5px; line-height: 1.7; color: rgba(17, 17, 68, .8); margin: 18px 0 0; }
.bio-body strong { color: var(--navy-ink); }

/* reveal on scroll */
.reveal { opacity: 0; transform: translateY(24px); transition: opacity .6s ease, transform .6s ease; }
.reveal.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
body.no-motion .reveal { opacity: 1; transform: none; transition: none; }
body.no-motion .icon-chip svg { animation: none; }
body.no-motion .cta, body.no-motion .solve-card, body.no-motion .proof-card { transition: none; }
body.no-motion .cta:hover, body.no-motion .solve-card:hover, body.no-motion .proof-card:hover { transform: none; }

@media (max-width: 900px) {
  .solve-grid { grid-template-columns: 1fr; }
  .about-grid { grid-template-columns: 1fr; }
