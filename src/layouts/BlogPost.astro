---
import BaseLayout from './BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, slug, category, pubDate, readTime, cover } = post.data;

const displayDate = pubDate.toLocaleDateString('en-AU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const isoDate = pubDate.toISOString();

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = allPosts
  .filter((p) => p.data.slug !== slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: cover ? new URL(cover.src, Astro.site).toString() : undefined,
  datePublished: isoDate,
  dateModified: isoDate,
  author: { '@type': 'Person', name: 'Elesha Piper', url: 'https://eleshapiper.com.au' },
  publisher: { '@type': 'Person', name: 'Elesha Piper' },
  mainEntityOfPage: new URL(`/blog/${slug}`, Astro.site).toString(),
};
---

<BaseLayout title={`${title} — Elesha Piper`} description={description} path={`/blog/${slug}`} ogImage={cover?.src} jsonLd={jsonLd}>
  <nav class="nav">
    <a href="/" class="nav-brand">Elesha Piper</a>
    <a href="/#packages">Packages</a>
    <a href="/blog">Blog</a>
    <a href="/#about">About</a>
    <a href="mailto:hello@eleshapiper.com.au" class="cta cta-navy" style="color:#fff;">Get in touch</a>
  </nav>

  <article>
    <header class="post-head">
      <div class="wrap">
        <p class="crumbs"><a href="/blog">Blog</a> &nbsp;/&nbsp; {category}</p>
        <span class="post-cat">{category}</span>
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <span>By Elesha Piper</span>
          <span class="dot"></span>
          <span>{displayDate}</span>
          <span class="dot"></span>
          <span>{readTime}</span>
        </div>
      </div>
    </header>

    <div class="post-hero">
      <div class="wrap">
        {cover ? (
          <Image src={cover} alt={title} width={1000} height={525} style="width:100%; height:auto; border-radius:24px; box-shadow:var(--shadow-2); border:1px solid #DAD1C8;" />
        ) : (
          <div class="img-ph">Cover image — 16:9</div>
        )}
      </div>
    </div>

    <div class="prose">
      <slot />
    </div>

    <div class="inline-cta">
      <div class="inline-cta-inner">
        <h3>Want this done for you?</h3>
        <p>If turning your own expertise into content like this sounds like a relief, that's exactly what I do.</p>
        <a href="/#packages" class="cta cta-yellow">See the packages</a>
      </div>
    </div>

    <div class="author">
      <div class="author-card">
        <div class="author-avatar">EP</div>
        <div>
          <h4>Elesha Piper</h4>
          <p class="author-role">LinkedIn Content Strategist</p>
          <p>I help consultants and advisors turn hard-won expertise into LinkedIn content that gets them found — by buyers and by the AI tools buyers now ask. Ten-plus years writing across every industry you can name.</p>
        </div>
      </div>
    </div>
  </article>

  <!-- TODO: wire this opt-in form to an email provider (Netlify Forms or Elesha's ESP — see templates-for-dev/README.md) before launch -->
  <section class="post-optin">
    <div class="wrap">
      <h2>Get the weekly LinkedIn playbook</h2>
      <p>Practical prompts and frameworks for consultants, straight to your inbox.</p>
      <form class="optin-form">
        <input type="email" name="email" placeholder="you@company.com" aria-label="Email address" required />
        <button type="submit" class="cta cta-yellow">Subscribe</button>
      </form>
      <p class="optin-note">No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <h2 class="section-title">Keep reading</h2>
        <div class="related-grid">
          {related.map((p) => <BlogCard post={p} />)}
        </div>
      </div>
    </section>
  )}

  <footer class="site-footer">© 2026 Elesha Piper — LinkedIn content strategy, newsletters and articles.</footer>
</BaseLayout>

<style is:global>
  /* ---- article header ---- */
  .post-head { padding: clamp(48px, 7vh, 88px) 0 clamp(28px, 4vh, 44px); }
  .post-head .wrap { max-width: 820px; }
  .crumbs { font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; opacity: .6; }
  .crumbs a { text-decoration: none; }
  .post-cat { display: inline-block; margin-top: 22px; font-size: 13px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--navy); background: rgba(34,51,130,.08); border-radius: 999px; padding: 7px 16px; }
  .post-title { font-size: clamp(38px, 6vw, 68px); line-height: .98; margin: 20px 0 0; color: var(--navy-ink); }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 26px;
    font-size: 14px; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: rgba(17,17,68,.6); }
  .post-meta .dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .5; }

  /* hero image */
  .post-hero { margin: clamp(28px, 4vh, 44px) 0 0; }
  .post-hero .wrap { max-width: 1000px; }

  /* ---- prose body ---- */
  .prose { max-width: 720px; margin: clamp(40px, 6vh, 72px) auto 0; padding: 0 var(--edge); }
  .prose > * + * { margin-top: 1.15em; }
  .prose p { font-size: 18px; line-height: 1.75; color: rgba(17,17,68,.86); }
  .prose h2 { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.05; color: var(--navy-ink); margin-top: 1.8em; }
  .prose h3 { font-size: clamp(21px, 2.6vw, 26px); line-height: 1.1; color: var(--navy-ink); margin-top: 1.6em; }
  .prose a { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(34,51,130,.4); }
  .prose a:hover { text-decoration-color: var(--navy); }
  .prose ul, .prose ol { padding-left: 1.3em; }
  .prose li { font-size: 18px; line-height: 1.7; color: rgba(17,17,68,.86); margin-top: .5em; }
  .prose li::marker { color: var(--green); }
  .prose strong { color: var(--navy-ink); }
  .prose blockquote { margin: 1.6em 0; padding: 4px 0 4px 28px; border-left: 4px solid var(--green);
    font-family: var(--font-heading); font-weight: 500; text-transform: none; letter-spacing: 0; font-size: clamp(22px, 3vw, 30px);
    line-height: 1.2; color: var(--navy); }
  .prose figure { margin: 1.6em 0; }
  .prose figcaption { font-size: 14px; color: rgba(17,17,68,.55); margin-top: 10px; text-align: center; }
  .prose hr { border: 0; border-top: 1px solid #DAD1C8; margin: 2.4em 0; }

  /* pull CTA inside article */
  .inline-cta { max-width: 720px; margin: clamp(40px, 6vh, 64px) auto 0; padding: 0 var(--edge); }
  .inline-cta-inner { position: relative; overflow: clip; border-radius: var(--r-lg); color: #fff;
    padding: clamp(28px, 4vw, 44px); background: linear-gradient(160deg, #2a3a94, var(--navy-deep) 55%, var(--navy-ink));
    box-shadow: var(--shadow-2); }
  .inline-cta-inner::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 6px;
    background: linear-gradient(180deg, var(--green), var(--turq)); }
  .inline-cta h3 { font-size: clamp(22px, 3vw, 30px); line-height: 1.05; margin: 0; }
  .inline-cta p { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,.85); margin: 12px 0 22px; max-width: 52ch; }

  /* ---- author bio ---- */
  .author { max-width: 720px; margin: clamp(48px, 7vh, 80px) auto 0; padding: 0 var(--edge); }
  .author-card { display: flex; gap: 22px; align-items: flex-start; background: #fff; border: 1px solid #DAD1C8;
    border-radius: var(--r-lg); padding: 28px; box-shadow: var(--shadow-1); }
  .author-avatar { flex: none; width: 72px; height: 72px; border-radius: 50%;
    background: linear-gradient(150deg, #2f42a5, var(--navy-deep)); display: grid; place-items: center;
    color: #fff; font-family: var(--font-heading); font-weight: 700; font-size: 26px;
    box-shadow: 0 0 0 3px #fff, 0 0 0 5px var(--turq); }
  .author-card h4 { margin: 0; font-size: 18px; color: var(--navy-ink); }
  .author-role { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--green); margin: 4px 0 0; }
  .author-card p { font-size: 15px; line-height: 1.65; color: rgba(17,17,68,.75); margin: 12px 0 0; }

  /* ---- newsletter band (lead capture at end of post) ---- */
  .post-optin { margin: clamp(56px, 8vh, 96px) 0 0; padding: clamp(48px, 7vh, 80px) 0; position: relative; overflow: clip; color: #fff;
    background: radial-gradient(700px 450px at 90% -10%, rgba(155,172,216,.25), transparent 55%),
      linear-gradient(160deg, #2a3a94 0%, var(--navy-deep) 50%, var(--navy-ink) 100%); }
  .post-optin .wrap { max-width: 720px; text-align: center; }
  .post-optin h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.02; margin: 0; }
  .post-optin p { font-size: 16px; line-height: 1.6; color: rgba(255,255,255,.85); margin: 14px auto 26px; max-width: 52ch; }
  .optin-form { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; max-width: 520px; margin: 0 auto; }
  .optin-form input { flex: 1; min-width: 220px; padding: 15px 20px; border-radius: 999px; border: 1px solid rgba(255,255,255,.4);
    background: rgba(255,255,255,.1); color: #fff; font-family: var(--font-body); font-size: 16px; }
  .optin-form input::placeholder { color: rgba(255,255,255,.6); }
  .optin-form input:focus-visible { outline: 2px solid var(--turq); outline-offset: 2px; }
  .optin-note { font-size: 12px; letter-spacing: .04em; color: rgba(255,255,255,.55); margin-top: 16px; }

  /* ---- related ---- */
  .related { padding: clamp(56px, 8vh, 96px) 0; }
  .related .section-title { font-size: clamp(28px, 3.6vw, 40px); color: var(--navy-ink); margin: 0 0 40px; }

  footer.site-footer { padding: 40px var(--edge); text-align: center; font-size: 14px; color: rgba(17,17,68,.6);
    border-top: 1px solid #DAD1C8; }
</style>
